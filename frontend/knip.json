{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,tsx}!"],
  "typescript": {
    "config": "tsconfig.json"
  },
  "paths": {
    "@/*": ["src/*"]
  },
  "ignore": [
    "src/components/ui/**",
    "src/hooks/**",
    "src/api/announcement.ts"
  ],
  "ignoreDependencies": [
    "@fontsource/inter",
    "@fontsource/poppins",
    "@radix-ui/*",
    "date-fns"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "off"
  }
}
