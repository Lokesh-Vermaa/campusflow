# CampusFlow Environment Variables
# Copy this file to .env and fill in values

# API base URL (real backend)
VITE_API_BASE_URL=http://localhost:8080

# App title
VITE_APP_TITLE=JKLU CampusFlow

# Feature flags
# Set to 'true' to enable MSW mock service worker (dev/demo without backend)
VITE_ENABLE_MSW=false

# Set to 'false' to use the real backend instead of MSW mocks
VITE_USE_MOCKS=true

# Demo mode: show the demo accounts box on the login page
# Set to 'true' for judge/demo environments, 'false' for production
VITE_DEMO_MODE=false

# Demo password: used by the demo accounts quick-fill buttons.
# Never hardcode this in source; always read from this env var.
# Must match the password configured for demo users in the backend (DEMO_USER_PASSWORD).
VITE_DEMO_PASSWORD=change-me-demo-password
